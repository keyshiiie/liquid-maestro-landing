---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__row">
      <div class="footer__social">
        <a href="#" class="social-link" aria-label="Instagram">
          <img src={`${import.meta.env.BASE_URL}/img/Subtract.svg`} alt="" width="24" height="24" />
        </a>
        <a href="#" class="social-link" aria-label="Twitter">
          <img src={`${import.meta.env.BASE_URL}/img/Twitter.svg`} alt="" width="24" height="24" />
        </a>
        <a href="#" class="social-link" aria-label="Facebook">
          <img src={`${import.meta.env.BASE_URL}/img/Facebook.svg`} alt="" width="24" height="24" />
        </a>
      </div>
      <div class="footer__logo">
        <div class="logo">
          <img src={`${import.meta.env.BASE_URL}/img/logo.png`} alt="" class="logo__img" width="36" height="36" />
          <p class="logo__text">Liquid Maestro</p>
        </div>
        <p class="footer__afterword">
          World of extraordinary flavors & unrivaled mixology expertise
        </p>
      </div>
      <div class="footer__copyright">
        <a href="#" class="copyright-link">Copyright © {year} XIDE</a>
        <a href="#" class="design-author-link">Design by <span>XIDE</span></a>
      </div>
    </div>
  </div>
</footer>