---
---
<section class="schedule" id="schedule">
  <div class="container">
    <div class="schedule__grid">
      
      <!-- Первый блок: Opening Hours -->
      <div class="schedule__block">
        <h3 class="section__title"><b>Opening</b> Hours</h3>
        <div class="hours">
          <div class="hours__item">
            <span class="hours__day">Mon - Thu:</span>
            <span class="hours__time">5 PM - 12 AM</span>
          </div>
          <div class="hours__item">
            <span class="hours__day">Fri - Sat:</span>
            <span class="hours__time">5 PM - 2 AM</span>
          </div>
          <div class="hours__item">
            <span class="hours__day">Sun:</span>
            <span class="hours__time hours__time--closed">Closed</span>
          </div>
        </div>
      </div>

      <!-- Второй блок: Contact Info -->
      <div class="schedule__block">
        <h3 class="section__title"><b>Contact</b> Info</h3>
        <div class="hours">
          <div class="hours__item">
            <span class="hours__day">Phone:</span>
            <span class="hours__time">(555) 123-4567</span>
          </div>
          <div class="hours__item">
            <span class="hours__day">Email:</span>
            <span class="hours__time">info@liquidmaestro.com</span>
          </div>
        </div>
      </div>

    </div>
  </div>
  
  <img src={`${import.meta.env.BASE_URL}/img/decor-o.svg`} alt="" class="decor-cross" aria-hidden="true" />
</section>