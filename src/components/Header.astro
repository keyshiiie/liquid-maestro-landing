---
import BurgerMenu from './BurgerMenu.astro';
---
<header class="header">
  <div class="container">
    <div class="header__row">
      <a href={`${import.meta.env.BASE_URL}/`} class="logo" aria-label="Liquid Maestro — home">
        <img src={`${import.meta.env.BASE_URL}/img/logo.png`} alt="" class="logo__img" width="36" height="36" />
        <p class="logo__text">Liquid Maestro</p>
      </a>
      <BurgerMenu />
    </div>
  </div>
</header>