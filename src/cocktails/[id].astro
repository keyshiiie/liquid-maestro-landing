---
import Layout from '../layouts/Layout.astro';
import menuData from '../content/menu.json';
import { Image } from 'astro:assets';

// Эта функция говорит Astro: "Сгенерируй страницу для каждого ID из JSON"
export async function getStaticPaths() {
  return menuData.map((drink) => ({
    params: { id: drink.id },
  }));
}

const { id } = Astro.params;
const drink = menuData.find((item) => item.id === id);

if (!drink) {
  return Astro.redirect('/404');
}

const images = import.meta.glob<{ default: ImageMetadata }>('../../cocktails/*.png', {
  eager: true,
});
const image = images[`../../cocktails/${drink.image}`]?.default;
---
<Layout title={`${drink.title} — Liquid Maestro`}>
  <main class="main" style="min-height: 100vh; padding: 120px 20px;">
    <div class="container">
      <!-- Кнопка назад -->
      <a href="/#menu" style="color: var(--accent); display: inline-block; margin-bottom: 40px; font-family: var(--font-sans); text-transform: uppercase;">
        &larr; Back to Menu
      </a>

      <div style="display: flex; gap: 60px; align-items: center; flex-wrap: wrap;">
        <!-- Картинка коктейля -->
        <div style="flex: 1; min-width: 300px; display: flex; justify-content: center;">
          {image ? (
            <Image src={image} alt={drink.alt} width={400} height={400} style="max-height: 500px; object-fit: contain;" />
          ) : (
            <p>Image not found</p>
          )}
        </div>

        <!-- Текстовая часть -->
        <div style="flex: 1; min-width: 300px;">
          <h1 style="font-size: clamp(40px, 6vw, 64px); font-weight: 700; margin-bottom: 20px; line-height: 1.1;">
            {drink.title}
          </h1>
          <p style="font-family: var(--font-sans); font-size: 20px; line-height: 1.6; opacity: 0.9; margin-bottom: 40px;">
            <span set:html={drink.description} />
          </p>
          
          <a href="/#booking" style="display: inline-block; border: 1px solid #fff; padding: 16px 40px; font-family: var(--font-sans); text-transform: uppercase; font-weight: 900; transition: all 0.3s ease;" onmouseover="this.style.background='#fff'; this.style.color='#000'" onmouseout="this.style.background='transparent'; this.style.color='#fff'">
            Book a Table
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>